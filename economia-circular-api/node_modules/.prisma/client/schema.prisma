generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nombre       String
  apellido     String?
  telefono     String?
  rol          String
  activo       Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Restaurante    Restaurante[]
  Cliente        Cliente?
  Proveedor      ProveedorPerfil?
  Notificaciones Notificacion[]
}

model Restaurante {
  id              String   @id @default(uuid())
  nombre          String
  direccion       String?
  telefono        String?
  nit             String?
  administradorId String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  Administrador Usuario             @relation(fields: [administradorId], references: [id])
  OrdenesCompra OrdenCompra[]
  Envases       Envase[]
  Transacciones TransaccionEnvase[]
}

model Cliente {
  id                String   @id @default(uuid())
  usuarioId         String   @unique
  nombre            String
  email             String?
  telefono          String?
  ecoPuntos         Int      @default(0)
  depositoAcumulado Float    @default(0.00)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  Usuario       Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  Transacciones TransaccionEnvase[]
}

model ProveedorPerfil {
  id          String   @id @default(uuid())
  usuarioId   String   @unique
  nit         String?
  direccion   String?
  descripcion String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  Productos     ProductoCatalogo[]
  OrdenesCompra OrdenCompra[]
}

model ProductoCatalogo {
  id              String   @id @default(uuid())
  proveedorId     String
  nombre          String
  descripcion     String?
  material        String
  capacidadMl     Int?
  dimensiones     String?
  precioUnitario  Float
  maxUsosEstimado Int
  imagenUrl       String?
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  Proveedor     ProveedorPerfil @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  DetallesOrden DetalleOrden[]
  Envases       Envase[]
}

model OrdenCompra {
  id            String   @id @default(uuid())
  restauranteId String
  proveedorId   String
  estado        String   @default("PENDIENTE") // PENDIENTE, ACEPTADA, EN_TRANSITO, ENTREGADA, CANCELADA
  total         Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  Restaurante Restaurante     @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  Proveedor   ProveedorPerfil @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  Detalles    DetalleOrden[]
}

model DetalleOrden {
  id             String @id @default(uuid())
  ordenId        String
  productoId     String
  cantidad       Int
  precioUnitario Float

  Orden    OrdenCompra      @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  Producto ProductoCatalogo @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Envase {
  qrCode        String   @id // El QR actúa como identificador único
  productoId    String
  restauranteId String?
  estado        String   @default("INACTIVO") // INACTIVO, EN_USO, LAVADO, DESECHADO
  usosActuales  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  Producto      ProductoCatalogo    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  Restaurante   Restaurante?        @relation(fields: [restauranteId], references: [id], onDelete: SetNull)
  Transacciones TransaccionEnvase[]
}

model TransaccionEnvase {
  id             String   @id @default(uuid())
  envaseQr       String
  restauranteId  String
  clienteId      String?
  tipoMovimiento String // PRESTAMO, RETORNO, LAVADO, DESCARTE
  fecha          DateTime @default(now())
  observaciones  String?

  Envase      Envase      @relation(fields: [envaseQr], references: [qrCode], onDelete: Cascade)
  Restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  Cliente     Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
}

model Notificacion {
  id        String   @id @default(uuid())
  usuarioId String
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  tipo      String   @default("INFO") // INFO, ALERTA, URGENTE
  createdAt DateTime @default(now())

  Usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
